@model Race_Day.Models.Participant

<h2>Delete Participant</h2>
<h4 class="text-danger">Are you sure you want to remove this participant?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">Participant ID</dt>
        <dd class="col-sm-10">@Model.ParticipantId</dd>

        <dt class="col-sm-2">User ID</dt>
        <dd class="col-sm-10">@Model.UserId</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ParticipantId" />
        <button type="submit" class="btn btn-danger">Yes, Remove</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>