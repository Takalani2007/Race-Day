@model Race_Day.Models.Result
<h2>Add Result</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Event ID</label>
        <input asp-for="EventId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Participant ID</label>
        <input asp-for="ParticipantId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Outcome (e.g. 1st Place)</label>
        <input asp-for="Outcome" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Score</label>
        <input asp-for="Score" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
</form>