@model IEnumerable<Race_Day.Models.Weather>
<h2>Weather Records</h2>
<p><a asp-action="Create" class="btn btn-primary">Add Weather</a></p>
<table class="table">
    <thead>
        <tr><th>Event ID</th><th>Condition</th><th>Temperature</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td>@w.EventId</td>
                <td>@w.Condition</td>
                <td>@w.Temperature °C</td>
                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@w.WeatherId" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>