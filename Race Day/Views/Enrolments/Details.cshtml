@model Race_Day.Models.Enrolment

<h2>Enrolment Details</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Enrolment ID</dt>
        <dd class="col-sm-10">@Model.EnrolmentId</dd>

        <dt class="col-sm-2">User ID</dt>
        <dd class="col-sm-10">@Model.UserId</dd>

        <dt class="col-sm-2">Event ID</dt>
        <dd class="col-sm-10">@Model.EventId</dd>

        <dt class="col-sm-2">Enrolled At</dt>
        <dd class="col-sm-10">@Model.EnrolledAt</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.EnrolmentId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>