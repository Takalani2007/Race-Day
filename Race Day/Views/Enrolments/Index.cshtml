@model IEnumerable<Race_Day.Models.Enrolment>

<h2>All Enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p><a asp-action="Create" class="btn btn-primary">Create Enrolment</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>User</th>
            <th>Event</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EnrolmentId</td>
                <td>@item.UserId</td>
                <td>@item.EventId</td>
                <td>@item.EnrolledAt.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EnrolmentId" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.EnrolmentId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.EnrolmentId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>