@model Race_Day.Models.Weather
<h2>Add Weather</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Event ID</label>
        <input asp-for="EventId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Condition</label>
        <input asp-for="Condition" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Temperature</label>
        <input asp-for="Temperature" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
</form>